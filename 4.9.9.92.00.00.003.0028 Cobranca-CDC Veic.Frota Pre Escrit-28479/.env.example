# Copie para .env e preencha. O .env não entra no git.
# O usuário do banco precisa ter só leitura (SELECT). O motor também recusa
# qualquer script que não seja um único SELECT.

# Nome que aparece na capa do Excel. Opcional.
CONCILIACAO_FEITO_POR=

# Oracle (Protheus)
ORA_USER=
ORA_PASS=
ORA_HOST=
ORA_PORT=1521
ORA_SERVICE=

# SQL Server (Sinqia)
# Se o Driver 17 estiver instalado, use: ODBC Driver 17 for SQL Server
MSSQL_DRIVER=SQL Server
MSSQL_HOST=
# Pode ficar vazio: o SELECT já usa SFINANCE_CT.dbo no FROM.
# Sem valor, a sessão abre em master.
MSSQL_DB=
MSSQL_USER=
MSSQL_PASS=
# yes só se o servidor não tiver certificado confiável
MSSQL_TRUST_SERVER_CERTIFICATE=yes

# Postgres — só se alguma conciliação usar um script com engine postgres
PG_USER=
PG_PASS=
PG_HOST=
PG_PORT=5432
PG_DB=
